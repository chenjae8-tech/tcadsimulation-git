  * mu_dop = mumin1 exp(-Pc/N) + (mu_const - mumin2)/(1+(N/Cr)^alpha)
  *                             - mu1/(1+(Cs/N)^beta)
  * with mu_const from ConstantMobility
   mumin1   = 52.2 ,   44.9   # [cm^2/Vs]
   mumin2   = 52.2 ,   0.0000e+00   # [cm^2/Vs]
   mu1   = 43.4 ,   29   # [cm^2/Vs]
   Pc   = 0.0000e+00 ,   9.2300e+16   # [cm^3]
   Cr   = 9.6800e+16 ,   2.2300e+17   # [cm^3]
   Cs   = 3.4300e+20 ,   6.1000e+20   # [cm^3]
   alpha   = 0.68 ,   0.719   # [1]
   beta   = 2 ,   2   # [1]
}

BalMob:
{
  * mu_bal = k * Lch, with Lch [nm] from in input file
  * KVM, no explicit Lch dependence with additional parameters:
  *      Tfactor  - thermionic emission related factor in kinetic velocity
  *      Bfactor  - distribution factor related to free carrier acceleration
  *      V0factor - initial kinetic velocity factor
   k   = 20 ,   20   # [cm^2/(V s nm)]
   Tfactor   = 2 ,   2   # [1]
   Bfactor   = 0.3 ,   0.3   # [1]
   V0factor   = 1 ,   1   # [1]
}

